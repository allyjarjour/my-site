{
	"functions": {
		"source": "functions"
	},
	"hosting": {
		"public": "dist",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"rewrites": [
			{
				"source": "/api/now-playing",
				"function": "nowPlaying"
			},
			{
				"source": "**",
				"destination": "/index.html"
			}
		]
	}
}
